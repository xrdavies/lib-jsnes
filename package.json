{
  "name": "lib-jsnes",
  "version": "0.1.0",
  "description": "A TypeScript NES emulator core for Node.js and browsers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "build:wasm": "node scripts/build-wasm.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "assemblyscript": "^0.28.20"
  },
  "keywords": [
    "nes",
    "emulator",
    "nintendo",
    "wasm"
  ],
  "license": "MIT"
}
