{
  "name": "lib-jsnes",
  "version": "0.1.0",
  "description": "A TypeScript NES emulator core for Node.js and browsers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./dist-wasm/lib-jsnes.wasm"
  },
  "files": [
    "dist",
    "dist-wasm"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run build:wasm && node --test test/*.test.js",
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepare": "npm run build && npm run build:wasm",
    "prepublishOnly": "npm run build && npm run build:wasm"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "assemblyscript": "^0.28.20"
  },
  "keywords": [
    "nes",
    "emulator",
    "nintendo",
    "wasm"
  ],
  "license": "MIT",
  "browser": "./dist/index.js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/xrdavies/lib-jsnes.git"
  },
  "bugs": {
    "url": "https://github.com/xrdavies/lib-jsnes/issues"
  },
  "homepage": "https://github.com/xrdavies/lib-jsnes#readme",
  "engines": {
    "node": ">=18"
  },
  "module": "./dist/index.js"
}
